<?xml version="1.0" encoding="utf-8"?>
<!--
  Dimenzy launcher foreground: a 3D cube inside AR viewfinder corners.
  White only, faces told apart by alpha, so the same layer works as the themed (monochrome) icon.
  Everything sits inside the 66dp safe zone in the middle of the 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder corners -->
    <path
        android:pathData="M32,41L32,32L41,32M67,32L76,32L76,41M76,67L76,76L67,76M41,76L32,76L32,67"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cube: top face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,38L68.72,46.5L54,55L39.28,46.5Z" />
    <!-- Cube: left face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.72"
        android:pathData="M39.28,46.5L54,55L54,72L39.28,63.5Z" />
    <!-- Cube: right face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M54,55L68.72,46.5L68.72,63.5L54,72Z" />
</vector>
